{
  "name": "@woisol-g/wgc",
  "version": "1.0.2",
  "description": "Format a My-Git-Commit message and run Git",
  "type": "module",
  "bin": {
    "wy-git-commit": "dist/cli.js",
    "wgc": "dist/cli.js"
  },
  "files": [
    "dist",
    "config/default.yml"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node --experimental-strip-types src/cli.ts",
    "build": "rolldown -c",
    "test": "pnpm run build && node --test",
    "prepack": "pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "rolldown": "1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woisol/wy-git-commit-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}